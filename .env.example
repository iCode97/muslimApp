# MuslimApp — environment variables (copy to .env; never commit real keys)

# --- Web Push (prayer & dhikr reminders while the app is closed) -------------
# Generate a key pair with:  npm run vapid
# If any of these three is missing, push is disabled gracefully and the app
# falls back to local reminders that only fire while it is open.
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL)
NUXT_VAPID_SUBJECT=mailto:admin@example.com

# Subscribers are stored as JSON files in ./.data/push (Nitro storage "push").
# In Docker, mount a volume on /app/.data so they survive redeploys.

# --- Optional -----------------------------------------------------------------
# Upstream for the Aladhan proxy (/api/aladhan/**)
# NUXT_ALADHAN_BASE_URL=https://api.aladhan.com/v1
